<resources>
    <!-- Compose draws everything; this only sets the window before it does. -->
    <style name="Theme.GhostBlue" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Shortcuts and automation: no window to see while a command is handed to the car. -->
    <style name="Theme.GhostBlue.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the device in Android's backups or device-to-device transfers:
    the database holds account passwords, PINs and tokens. GhostBlue's own
    backup file is the way to move to another phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
